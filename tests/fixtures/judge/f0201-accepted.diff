+
+        petFromOwner.Should().BeEquivalentTo(petDetails,
+            because: $"the GET /owners/{ownerId}/pets/{petDetails.Id} response should fully match the GET /pets/{petDetails.Id} response for pet id {petDetails.Id}");
+    }
